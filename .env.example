# Скопируйте этот файл в .env и заполните значения.
# .env в репозиторий не коммитится.

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Ваш числовой id в Telegram — только этому пользователю бот отвечает в личке.
# Узнать: написать @userinfobot
OWNER_ID=

# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_KEY=

# Модель OpenRouter в виде «производитель/модель».
# Список и цены — https://openrouter.ai/models
MODEL=openai/gpt-5.6-sol

# Прокси — используется и для Telegram, и для OpenRouter.
# Вид: http://логин:пароль@адрес:порт
# Пусто — работать напрямую.
PROXY=
